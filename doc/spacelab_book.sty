\ProvidesPackage{spacelab_book}

\usepackage[left=2.5cm,right=2.5cm,top=2.5cm,bottom=2.5cm]{geometry}
\usepackage[T1]{fontenc}  
\usepackage[utf8]{inputenc}
\usepackage[english]{babel}
\usepackage{ae}
\usepackage{graphicx}
\usepackage[hidelinks]{hyperref}
\usepackage{xurl}
\usepackage{fancyhdr}
% Compatibility shims for KOMA-Script 3.45 / LaTeX 2023 where \IfPackageLoadedF/T were renamed
\makeatletter
\@ifundefined{IfPackageLoadedF}{\newcommand*{\IfPackageLoadedF}[2]{\@ifpackageloaded{#1}{}{#2}}}{}
\@ifundefined{IfPackageLoadedT}{\newcommand*{\IfPackageLoadedT}[2]{\@ifpackageloaded{#1}{#2}{}}}{}
\@ifundefined{IfPackageLoadedTF}{\newcommand*{\IfPackageLoadedTF}[3]{\@ifpackageloaded{#1}{#2}{#3}}}{}
\makeatother
\usepackage{nomencl}				% Nomenclature list
\usepackage{float}
\usepackage{booktabs}
\usepackage{titlesec}
\usepackage{emptypage}
\usepackage{lettrine}				% First letter bigger in the begining of a chapter
\usepackage{tabularx}
\usepackage{enumitem}				% Custom enumerate
\usepackage[toc,page]{appendix}     % Appendix
\usepackage{titling}
\usepackage{pdfpages}               % Include PDF documents
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{multirow}
\usepackage[toc,page]{appendix}     % Appendix
\usepackage{lscape}
\usepackage[bottom]{footmisc}
\usepackage{multicol}
\usepackage{caption}                % \caption*
\usepackage{subcaption} % for side-by-side subfigures (replaces deprecated subfigure) — Source: https://tex.stackexchange.com/a/282878 (Fran, CC BY-SA 3.0)
\usepackage{listings}               % Codes
\usepackage[outdir=figures/]{epstopdf}
\usepackage{longtable}              % Multiple pages table
\usepackage[math]{iwona}
\usepackage{xcolor}
% colortbl disabled for MiKTeX 2026/2023 compatibility; provide dummy \cellcolor if not loaded
\makeatletter
\@ifundefined{cellcolor}{\newcommand{\cellcolor}[1]{}}{}
\makeatother

% URLs font style — xurl allows breaks at any char in \path/\url (fixes page 17 CircularPatchAntenna.kicad_mod overfull)
\urlstyle{same}
\setlength{\emergencystretch}{3em}

% Bibliography style (order of appearance)
\bibliographystyle{unsrt}

% First chapter page style
\titleformat{\chapter}[display]
    {\bfseries\Large}
    {\filright\MakeUppercase{\chaptertitlename} \Large\thechapter}
    {1ex}
    {\titlerule\vspace{1ex}\filleft}
    [\vspace{1ex}\titlerule]

% Header style
\pagestyle{fancy}
\fancyhf{}
\fancyhead[RO]{\nouppercase{\rightmark}}
\fancyhead[LE]{\nouppercase{\leftmark}}
\fancyfoot[RO]{\thepage}
\fancyfoot[LE]{\thepage}
\renewcommand{\footrulewidth}{0.5pt} 

% List of abbreviations
\makenomenclature
\setlength\nomlabelwidth{2cm}

% Table cell size limit and alignment
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}

% Fill a cell of a table
\newcommand{\fc}{\cellcolor{gray}}